  "permission": [
    {
      "target": "https://calcolomediazione.it/*",
      "action": "read",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "personalUse"
        }
      ]
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "read",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "search-engine-indexing"
        }
      ]
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "read",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "academic-citation"
        }
      ],
      "duty": [
        {
          "action": "attribute",
          "constraint": [
            {
              "leftOperand": "creator",
              "operator": "eq",
              "rightOperand": "Avv. Carlo Alberto Calcagno"
            },
            {
              "leftOperand": "source",
              "operator": "eq",
              "rightOperand": "https://calcolomediazione.it"
            }
          ]
        }
      ]
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "read",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "real-time-user-query-answering"
        }
      ],
      "assignee": [
        "ChatGPT-User", "OAI-SearchBot", "Claude-Web", "Claude-SearchBot",
        "Perplexity-User", "PerplexityBot", "YouBot", "MistralAI-User"
      ],
      "duty": [
        {
          "action": "attribute",
          "constraint": [
            {
              "leftOperand": "source",
              "operator": "eq",
              "rightOperand": "https://calcolomediazione.it"
            }
          ]
        }
      ]
    }
  ],
  "prohibition": [
    {
      "target": "https://calcolomediazione.it/*",
      "action": "extract",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "ai-training"
        }
      ]
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "extract",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "machine-learning"
        }
      ]
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "extract",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "fine-tuning"
        }
      ]
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "extract",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "bulk-rag-index-ingestion"
        }
      ],
      "_note": "Vietata l'estrazione massiva/automatizzata per costruire o alimentare un indice RAG proprio. Non riguarda la singola risposta in tempo reale a una query utente da parte degli agenti elencati nel permission block 'real-time-user-query-answering' qui sopra, gia' esplicitamente ammessi anche in robots.txt."
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "extract",
      "constraint": [
        {
          "leftOperand": "purpose",
          "operator": "eq",
          "rightOperand": "embedding-generation"
        }
      ],
      "_note": "Vietata la generazione di embedding per la costruzione di indici o dataset propri, distinta dalla lettura in tempo reale ammessa sopra."
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "reproduce"
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "derive"
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "distribute"
    },
    {
      "target": "https://calcolomediazione.it/*",
      "action": "commercialize"
    }
  ],
  "tdm-reservation": 1,
  "tdm-policy": "https://calcolomediazione.it/termini-condizioni",
  "_human_readable_notice": "Tutti i contenuti del portale calcolomediazione.it sono protetti da copyright (L. 633/1941). L'autore esercita espressamente la riserva ex art. 70-quater L. 633/1941 e art. 4 Direttiva 2019/790: VIETATO l'uso dei contenuti per addestramento di modelli di intelligenza artificiale, fine-tuning, o per alimentare in modo massivo/automatizzato indici RAG o dataset di embedding propri di terzi. Restano ammessi la normale indicizzazione dei motori di ricerca e, con obbligo di attribuzione della fonte, la lettura in tempo reale da parte di assistenti AI che rispondono a una query specifica di un utente (es. ChatGPT-User, Claude-Web, PerplexityBot e agenti equivalenti, gia' esplicitamente ammessi in robots.txt) — coerentemente con l'elenco Allow/Disallow del file robots.txt del Sito. Per richieste di licenza relative a usi ulteriori: vedi pagina termini-condizioni."
}
